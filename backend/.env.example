# NutriRegion Colombia - configuracion de desarrollo
# Copiar a .env y ajustar. NUNCA commitear .env (ver .gitignore).

# Ruta de la base de datos SQLite de desarrollo (usar ruta absoluta)
NUTRI_DB_URL=sqlite:///C:/nutri-region-colombia/backend/nutriregion.db

# Secreto JWT. En produccion: valor aleatorio largo gestionado fuera del repo.
NUTRI_JWT_SECRET=cambiar-por-secreto-largo-aleatorio
NUTRI_JWT_EXPIRATION_HOURS=24

# Modo piloto: permite que el motor evalue reglas clinicas con status=candidate
# mientras no exista aprobacion profesional. La UI lo senala con un banner visible.
# Produccion: false hasta que un profesional competente apruebe las reglas.
NUTRI_RULES_PILOT_MODE=true

# Capa IA opcional (desactivada por defecto; ver ADR-0009)
NUTRI_AI_ENABLED=false
NUTRI_OLLAMA_BASE_URL=http://localhost:11434
NUTRI_OLLAMA_MODEL=qwen3.5:4b

# Cuenta administradora inicial (solo se crea si no existe)
NUTRI_ADMIN_EMAIL=admin@nutriregion.local
NUTRI_ADMIN_PASSWORD=nutri-admin-dev
